# Express API
PORT=4000
# Comma-separated exact browser origins. Local Vite default is http://localhost:5173.
CLIENT_ORIGIN=http://localhost:5173

# Required demo login. Set unique values in server/.env or the API host's environment.
# Generate the signing secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DEMO_LOGIN_USERNAME=
DEMO_LOGIN_PASSWORD=
DEMO_AUTH_SECRET=

# Optional production persistence. Keep the secret key on the API server only.
# Leave both blank to use persistent local JSON development mode.
ROSTEROS_STORAGE_MODE=auto
ROSTEROS_STORE_PATH=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role key name is also accepted by the server during key migration.
# SUPABASE_SERVICE_ROLE_KEY=

